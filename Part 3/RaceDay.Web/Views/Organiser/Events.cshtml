@model OrganiserDashboardViewModel
@{
    ViewData["Title"] = "My events";
}
<div class="page-heading"><div><span class="eyebrow eyebrow-dark">EVENT MANAGEMENT</span><h1>My events</h1><p>Create, update and manage every race you're hosting.</p></div><a class="btn btn-accent" asp-action="Create">＋ New event</a></div>
@if (Model.Events.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">◎</div><h3>No events yet</h3><p>Your events will appear here once you create one.</p><a class="btn btn-accent" asp-action="Create">Create an event</a></div>
}
else
{
    <div class="event-grid event-grid-management">
    @foreach (var item in Model.Events)
    {
        <article class="event-card management-card">
            @if (!string.IsNullOrWhiteSpace(item.BannerUrl)) { <div class="management-banner" style="background-image:url('@item.BannerUrl')"></div> }
            else { <div class="event-card-art"><span class="event-type-pill">@item.Event.EventType</span><span class="event-card-symbol">↗</span><div class="event-card-date"><strong>@item.Event.Date.ToString("dd")</strong><span>@item.Event.Date.ToString("MMM")</span></div></div> }
            <div class="event-card-body"><div class="event-meta">@item.Event.Location · @item.Event.Distance</div><h3>@item.Event.Name</h3><div class="management-counts"><span><strong>@item.EnrollmentCount</strong> participants</span><span><strong>@item.ResultCount</strong> results</span></div>
                <div class="management-actions"><a class="btn btn-outline-dark btn-sm" asp-action="Edit" asp-route-eventID="@item.Event.EventID">Edit</a><a class="btn btn-outline-dark btn-sm" asp-action="Categories" asp-route-eventID="@item.Event.EventID">Categories</a><a class="btn btn-outline-dark btn-sm" asp-action="Enrollments" asp-route-eventID="@item.Event.EventID">Participants</a><a class="btn btn-outline-dark btn-sm" asp-action="Results" asp-route-eventID="@item.Event.EventID">Results</a></div>
                <form asp-action="Delete" method="post" class="delete-form" onsubmit="return confirm('Delete this event? Events with categories or enrollments cannot be deleted.');"><input type="hidden" name="eventID" value="@item.Event.EventID" /><button type="submit" class="text-danger-link">Delete event</button></form>
            </div>
        </article>
    }
    </div>
}
