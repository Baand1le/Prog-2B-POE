@model List<ApiMyResult>
@{
    ViewData["Title"] = "My results";
}
<div class="page-heading"><div><span class="eyebrow eyebrow-dark">YOUR PERSONAL RECORD</span><h1>My results</h1><p>Every finish is progress. Here's your race history.</p></div></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon">✦</div><h3>Your results will appear here</h3><p>Once an organiser publishes your finish time, you'll see your race result here.</p><a class="text-link" asp-action="Index">Find your next race →</a></div>
}
else
{
    <div class="results-history">
    @foreach (var result in Model)
    {
        <article class="history-card"><div class="history-date"><strong>@result.EventDate.ToString("dd")</strong><span>@result.EventDate.ToString("MMM yyyy")</span></div><div class="history-main"><span class="event-meta">@result.CategoryName</span><h3>@result.EventName</h3></div><div class="history-stat"><span>Finish time</span><strong>@result.FinishTime.ToString()</strong></div><div class="history-stat"><span>Position</span><strong>#@result.FinishPosition <small>of @result.TotalFinishers</small></strong></div></article>
    }
    </div>
}
